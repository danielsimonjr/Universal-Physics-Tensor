{
  "name": "universal-physics-tensor",
  "version": "3.0.0",
  "description": "Computational framework for exploring unified physics through tensor formalism",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "upt": "bin/upt.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./numerical/mathts-engine": {
      "types": "./dist/numerical/mathts-engine.d.ts",
      "import": "./dist/numerical/mathts-engine.js",
      "default": "./dist/numerical/mathts-engine.js"
    },
    "./probe": {
      "types": "./dist/composition/probe/index.d.ts",
      "import": "./dist/composition/probe/index.js",
      "default": "./dist/composition/probe/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas/index.d.ts",
      "import": "./dist/atlas/index.js",
      "default": "./dist/atlas/index.js"
    }
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "build": "tsc",
    "dev": "tsc --watch",
    "smoke": "node test-example.js",
    "upt": "node bin/upt.mjs",
    "explain": "node bin/upt.mjs explain",
    "bridge-priority": "node bin/upt.mjs priority",
    "pretest": "tsc",
    "test": "vitest run",
    "test:atlas": "vitest run tests/atlas",
    "test:probe-coverage": "vitest run tests/composition/probe --coverage --coverage.thresholds.lines=95 --coverage.thresholds.statements=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=85",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.exclude='src/**/index.ts' --coverage.exclude='src/**/*.ambient.d.ts' --coverage.reporter=text-summary",
    "test:watch": "vitest",
    "prepublishOnly": "npm run validate",
    "bench": "vitest bench",
    "bench:ci": "vitest bench --reporter=verbose",
    "docs:deps": "bun tools/create-dependency-graph/create-dependency-graph.ts --root=. --include-tests",
    "docs:cli": "bun scripts/cli-reference.ts",
    "audit:plans": "bun tools/plan-doc-audit/audit.ts",
    "layer:check": "bun tools/layer-order/check.ts",
    "atlas:formal-gate": "bun tools/formalref-axiom-gate/gate.ts",
    "atlas:quote-check": "bun tools/citation-quote-check/check.ts",
    "atlas:c3-export": "bun tools/criterion3-export/export.ts",
    "atlas:c3-labels": "bun tools/criterion3-study/labels.ts",
    "atlas:c3-run": "bun tools/criterion3-study/run.ts",
    "catalog:json": "npm run build && node scripts/emit-catalog-json.mjs",
    "atlas:json": "npm run build && node scripts/emit-atlas-json.mjs",
    "atlas:witness-results": "npm run build && node scripts/emit-witness-results.mjs",
    "atlas:study": "npm run build && node scripts/run-atlas-study.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "validate": "npm run build && npm run typecheck && npm test && npm run audit:plans && npm run package:check",
    "package:check": "node scripts/package-smoke.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "physics",
    "tensor",
    "unification",
    "quantum-mechanics",
    "general-relativity",
    "bridge-equations",
    "theoretical-physics",
    "computational-physics"
  ],
  "author": "Daniel Simon Jr. <danielsimonjr@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/universal-physics-tensor.git"
  },
  "bugs": {
    "url": "https://github.com/danielsimonjr/universal-physics-tensor/issues"
  },
  "homepage": "https://github.com/danielsimonjr/universal-physics-tensor#readme",
  "dependencies": {
    "@danielsimonjr/mathts-autograd": "^0.3.16",
    "@danielsimonjr/mathts-core": "^0.16.0",
    "@danielsimonjr/mathts-expression": "^0.9.0",
    "@danielsimonjr/mathts-functions": "^0.67.0",
    "@danielsimonjr/mathts-matrix": "^0.7.6",
    "@danielsimonjr/mathts-parallel": "^0.6.8",
    "@danielsimonjr/mathts-tensor": "^0.2.22",
    "@danielsimonjr/mathts-wasm": "^0.3.0",
    "@danielsimonjr/mathts-workerpool": "^0.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@viz-js/viz": "^3.28.0",
    "fast-check": "^4.8.0",
    "js-yaml": "^5.0.0",
    "tree-sitter": "0.22.4",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@viz-js/viz": "^3.28.0"
  },
  "peerDependenciesMeta": {
    "@viz-js/viz": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}

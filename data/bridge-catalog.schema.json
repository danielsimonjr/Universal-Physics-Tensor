{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPT Bridge Catalog Artifact",
  "description": "The bridge catalog. data/bridge-catalog.json is the source; src/bridges/catalog-load.ts (and the dimension projection in src/dimensional/bridge-check.ts, through the same src/core/data-file.ts reader) validates it against this schema when it loads, with the keyword subset src/core/json-schema.ts reads. type is required on every record. derivedFrom and basis are absent until a derivation theorem is pinned. formalRef is derived from formalKey and is not stored.",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageVersion",
    "count",
    "entries",
    "relations",
    "evaluators",
    "confrontations",
    "adjudications",
    "spine"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "packageVersion": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "confrontations": {
      "type": "array",
      "description": "Committed real-data confrontations (predicted vs observed) — the empirical spine.",
      "items": {
        "type": "object",
        "required": [
          "catalogId",
          "title",
          "kind",
          "rigor",
          "outcome"
        ],
        "properties": {
          "catalogId": {
            "type": "integer",
            "minimum": 11
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "value",
              "upper-bound",
              "consistency",
              "table"
            ]
          },
          "rigor": {
            "enum": [
              "stringent",
              "moderate",
              "loose"
            ]
          },
          "outcome": {
            "type": "object"
          },
          "prediction": {
            "type": "object",
            "required": [
              "inputs"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            },
            "description": "Inputs of the prediction, in catalog quantity names, when elasticity is defined."
          }
        },
        "additionalProperties": false
      }
    },
    "adjudications": {
      "type": "array",
      "description": "Human adjudication ledger — recorded verdicts on discovery candidates (genuine/decoy/entailed/deferred).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "grounds",
          "source",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "candidateId(a, b): the two slugs in sorted order, joined by ~"
          },
          "verdict": {
            "enum": [
              "genuine",
              "decoy",
              "entailed",
              "deferred"
            ]
          },
          "grounds": {
            "type": "string",
            "description": "Why, condensed from the adjudication document"
          },
          "source": {
            "type": "string",
            "description": "Repo-relative path of the adjudication document"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date the verdict was recorded"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "category",
          "category_name",
          "bridges",
          "status",
          "formula_latex",
          "dimensional_signature",
          "references",
          "dependencies",
          "known_issues",
          "tractability_class",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 11
          },
          "type": {
            "enum": [
              "standard",
              "cross-domain"
            ]
          },
          "derivedFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Direct derivation imports. Absent until a derivation theorem is pinned."
          },
          "basis": {
            "const": true
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "bridges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "enum": [
              "established",
              "speculative",
              "highly-speculative",
              "invalid"
            ]
          },
          "formula_latex": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensional_signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "encoded_form": {
            "type": "string"
          },
          "scalarExpression": {
            "type": "string",
            "description": "Scalar expression for a row that has no relation. Parsed into the structural registry. Not a graph edge."
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "known_issues": {
            "type": "array"
          },
          "tractability_class": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "formalRef": {
            "type": "object",
            "description": "A PhysJS reference for one part of the equation. Optional. kind bridge is the only kind that lights formally-proved. A property lights formally-proved-property and a cross-check lights formally-proved-cross-check. A reduction, a limit, or a derivation-step lights neither. url is the theorem file at the pinned commit.",
            "required": [
              "system",
              "statement",
              "version",
              "axioms",
              "fidelity",
              "kind",
              "url",
              "covers"
            ],
            "additionalProperties": false,
            "properties": {
              "system": {
                "enum": [
                  "lean4-physlib",
                  "lean4-physjs",
                  "other"
                ]
              },
              "statement": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "axioms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fidelity": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "bridge",
                  "property",
                  "cross-check",
                  "reduction",
                  "limit",
                  "derivation-step"
                ]
              },
              "url": {
                "type": "string"
              },
              "covers": {
                "type": "string"
              }
            }
          },
          "context": {
            "type": "string"
          },
          "source_part": {
            "type": "string"
          },
          "source_section": {
            "type": "string"
          },
          "relation": {
            "type": "object",
            "description": "The relation record the row was filed with, when it has one."
          },
          "formalKey": {
            "type": "string",
            "pattern": "^(be|ab)-[a-z0-9-]+$",
            "description": "The PhysJS manifest key. formalRef, its kind included, is read from that manifest entry. The catalog stores no kind of its own."
          },
          "dimension": {
            "type": "object"
          },
          "conventions": {
            "type": "object"
          },
          "counterexamples": {
            "type": "array"
          },
          "regime": {
            "type": "object"
          },
          "callerTable": {
            "const": true
          },
          "statement": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopeLimits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "Closed forms. Several relations may share one catalog id; catalogId null is a law with no catalog row.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "catalogId",
          "kind",
          "label",
          "expression",
          "target",
          "sources",
          "aliases",
          "holds",
          "domain",
          "citation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "catalogId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "bridge",
              "law"
            ]
          },
          "label": {
            "type": "string"
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "holds": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "established",
              "speculative",
              "highly-speculative"
            ],
            "description": "Stored only on a relation with no catalog row (catalogId null). A relation with a row takes its row's status when the catalog loads; src/bridges/catalog-load.ts refuses a stored copy beside a catalog id."
          },
          "citation": {
            "type": "string"
          },
          "coefficientUnset": {
            "type": "boolean"
          },
          "formulaFactors": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "relation": {
            "type": "object"
          },
          "regime": {
            "type": "object"
          },
          "conventions": {
            "type": "object"
          },
          "counterexamples": {
            "type": "array"
          },
          "reference": {
            "type": "object",
            "required": [
              "inputs",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "value": {
                "type": "number"
              }
            }
          },
          "notice": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluators": {
      "type": "array",
      "description": "The input contract of each catalog evaluator: its named inputs and any extra outputs.",
      "items": {
        "type": "object",
        "required": [
          "catalogId",
          "name",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "catalogId": {
            "type": "integer",
            "minimum": 11
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "quantity",
                "symbol",
                "unit",
                "meaning"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "geometry": {
                  "enum": [
                    "radius",
                    "diameter",
                    "separation",
                    "impact-parameter",
                    "semi-major-axis"
                  ]
                },
                "temperature": {
                  "const": "absolute"
                },
                "sign": {
                  "enum": [
                    "positive",
                    "nonnegative",
                    "any"
                  ]
                },
                "angular": {
                  "const": true
                },
                "optional": {
                  "const": true
                },
                "alternates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "meaning",
                      "toKey"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "meaning": {
                        "type": "string",
                        "minLength": 1
                      },
                      "toKey": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "unit",
                "meaning",
                "expression"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "type": "string",
                  "minLength": 1
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "spine": {
      "type": "object",
      "description": "Catalog id → the regime parameters of its evidence-spine confrontation, by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    }
  }
}

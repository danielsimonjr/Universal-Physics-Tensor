{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPT Bridge Catalog Artifact",
  "description": "Versioned JSON projection of src/bridges/index.ts BRIDGE_EQUATIONS plus the discovery review surfaces (v2, P10: confrontations + adjudications). The TypeScript sources are authoritative; regenerate with `npm run catalog:json`.",
  "type": "object",
  "required": ["schemaVersion", "packageVersion", "count", "entries", "confrontations", "adjudications"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "packageVersion": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "confrontations": {
      "type": "array",
      "description": "Committed real-data confrontations (predicted vs observed) — the empirical spine.",
      "items": {
        "type": "object",
        "required": ["bridgeId", "title", "kind", "outcome"],
        "properties": {
          "bridgeId": { "type": "integer" },
          "title": { "type": "string" },
          "kind": { "enum": ["value", "upper-bound", "consistency", "table"] },
          "outcome": { "type": "object" }
        }
      }
    },
    "adjudications": {
      "type": "array",
      "description": "Human adjudication ledger — recorded verdicts on discovery candidates (genuine/decoy/entailed/deferred).",
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string" },
          "verdict": { "enum": ["genuine", "decoy", "entailed", "deferred"] }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "category_name",
          "bridges",
          "status",
          "formula_latex",
          "dimensional_signature",
          "references",
          "dependencies",
          "known_issues",
          "tractability_class",
          "notes"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 11 },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "category_name": { "type": "string" },
          "bridges": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "enum": [
              "established",
              "speculative",
              "highly-speculative",
              "invalid"
            ]
          },
          "formula_latex": { "type": ["string", "null"] },
          "dimensional_signature": { "type": ["string", "null"] },
          "encoded_form": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "integer" } },
          "known_issues": { "type": "array" },
          "tractability_class": { "type": "string" },
          "notes": { "type": "string" },
          "formalRef": {
            "type": "object",
            "description": "A PhysJS reference for one part of the equation. Optional. The covers line begins with the kind: reduction, limit, derivation-step, property, or cross-check. A property or a cross-check is not a reduction, a limit, or a derivation-step. It does not light formally-proved.",
            "required": ["system", "statement", "version", "axioms", "fidelity", "covers"],
            "additionalProperties": false,
            "properties": {
              "system": { "enum": ["lean4-physlib", "lean4-physjs", "other"] },
              "statement": { "type": "string" },
              "version": { "type": "string" },
              "axioms": { "type": "array", "items": { "type": "string" } },
              "fidelity": { "type": "string" },
              "covers": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

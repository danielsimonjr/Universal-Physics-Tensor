{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPT Bridge Catalog Artifact",
  "description": "The bridge catalog. data/bridge-catalog.json is the source; src/bridges/catalog-load.ts (and the dimension projection in src/dimensional/bridge-check.ts, through the same src/core/data-file.ts reader) validates it against this schema when it loads, with the keyword subset src/core/json-schema.ts reads, then derives each relation's confidence from its row and the sign clauses from the evaluator flags. type is required on every record. formalRef is derived from formalKey and is not stored. Every field declared here has a reader in src/; a field nothing reads is not declared.",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageVersion",
    "entries",
    "relations",
    "evaluators",
    "confrontations",
    "adjudications",
    "spine",
    "rejections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    },
    "packageVersion": {
      "type": "string"
    },
    "confrontations": {
      "type": "array",
      "description": "Committed real-data confrontations (predicted vs observed) — the empirical spine.",
      "items": {
        "type": "object",
        "required": [
          "catalogId",
          "title",
          "kind",
          "rigor",
          "outcome"
        ],
        "properties": {
          "catalogId": {
            "type": "integer",
            "minimum": 11
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "value",
              "upper-bound",
              "consistency",
              "table"
            ]
          },
          "rigor": {
            "enum": [
              "stringent",
              "moderate",
              "loose"
            ]
          },
          "outcome": {
            "type": "object",
            "description": "src/bridges/observations/types.ts ConfrontationOutcome, discriminated on kind. The arm-specific fields are checked by src/bridges/catalog-load.ts when the catalog loads; the schema subset cannot state a union.",
            "required": [
              "kind",
              "units",
              "provenance",
              "preprocessing",
              "independence"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "value",
                  "upper-bound",
                  "consistency",
                  "table"
                ]
              },
              "units": {
                "type": "string"
              },
              "provenance": {
                "type": "object",
                "required": [
                  "citation",
                  "year",
                  "retrieved"
                ],
                "additionalProperties": false,
                "properties": {
                  "citation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "year": {
                    "type": "integer"
                  },
                  "retrieved": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "preprocessing": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "recorded",
                      "not-recorded"
                    ]
                  }
                }
              },
              "independence": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "no-fitted-parameter",
                      "shares-input",
                      "not-recorded"
                    ]
                  }
                }
              },
              "predicted": {
                "type": "number"
              },
              "observed": {
                "type": "number"
              },
              "sigma": {
                "type": "number"
              },
              "residualInSigma": {
                "type": "number"
              },
              "withinObserved": {
                "type": "boolean"
              },
              "measured": {
                "type": "object"
              },
              "bound": {
                "type": "number"
              },
              "satisfied": {
                "type": "boolean"
              },
              "predictedIs": {
                "enum": [
                  "point",
                  "encoded-bound",
                  "reference",
                  "lower-limit"
                ]
              },
              "caveat": {
                "type": "string"
              },
              "approaches": {
                "type": "number"
              },
              "fractionalGap": {
                "type": "number"
              },
              "fractionalGapIs": {
                "enum": [
                  "agreement-bound",
                  "observed-difference"
                ]
              },
              "rows": {
                "type": "array"
              }
            }
          },
          "prediction": {
            "type": "object",
            "required": [
              "inputs"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "The prediction point, in the evaluator's input spellings. The evaluator at these inputs returns outcome.predicted: its value, or the extra output `output` names. src/bridges/sensitivity.ts ranks the inputs by elasticity."
          }
        },
        "additionalProperties": false
      }
    },
    "adjudications": {
      "type": "array",
      "description": "Human adjudication ledger — recorded verdicts on discovery candidates (genuine/decoy/entailed/deferred).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict",
          "grounds",
          "source",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "candidateId(a, b): the two slugs in sorted order, joined by ~"
          },
          "verdict": {
            "enum": [
              "genuine",
              "decoy",
              "entailed",
              "deferred"
            ]
          },
          "grounds": {
            "type": "string",
            "description": "Why, condensed from the adjudication document"
          },
          "source": {
            "type": "string",
            "description": "Repo-relative path of the adjudication document"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date the verdict was recorded"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "category",
          "category_name",
          "bridges",
          "status",
          "formula_latex",
          "dimensional_signature",
          "references",
          "dependencies",
          "known_issues",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 11
          },
          "type": {
            "enum": [
              "standard",
              "cross-domain"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "pattern": "^[A-O]$",
            "description": "The §VI.6.1 category letter; src/bridges/tensor-index.ts maps it to a component."
          },
          "category_name": {
            "type": "string"
          },
          "bridges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "enum": [
              "established",
              "speculative",
              "highly-speculative",
              "invalid"
            ]
          },
          "formula_latex": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensional_signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "scalarExpression": {
            "type": "string",
            "description": "Scalar expression for a row that has no relation. Parsed into the structural registry. Not a graph edge."
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "known_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "description",
                "fixable"
              ],
              "additionalProperties": false,
              "properties": {
                "severity": {
                  "enum": [
                    "self-refuting",
                    "dimensional",
                    "index-structure",
                    "sign",
                    "undefined-quantity",
                    "phenomenological-ansatz",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "fixable": {
                  "enum": [
                    "spec-edit",
                    "reformulation",
                    "unfixable-must-mark-invalid",
                    "unknown"
                  ]
                }
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "source_part": {
            "enum": [
              "I",
              "II",
              "III",
              "IV",
              "V",
              "VI"
            ]
          },
          "source_section": {
            "type": "string"
          },
          "relation": {
            "type": "object",
            "description": "The relation contract of the row (src/relations/types.ts RelationContract); src/composition/catalog-graph.ts puts it on the edge.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "derivation",
                  "exact-equivalence",
                  "restriction",
                  "approximation",
                  "coarse-graining",
                  "analytic-continuation",
                  "structural-analogy",
                  "deformation-quantization"
                ]
              }
            }
          },
          "formalKey": {
            "type": "string",
            "pattern": "^be-[a-z0-9-]+$",
            "description": "The PhysJS manifest key. formalRef, its kind included, is read from that manifest entry. The catalog stores no kind of its own."
          },
          "dimension": {
            "type": "object"
          },
          "conventions": {
            "type": "object",
            "description": "src/relations/types.ts Conventions; src/atlas/derive-evidence.ts reads it for convention-checked.",
            "additionalProperties": false,
            "properties": {
              "heatWorkSign": {
                "enum": [
                  "Q-W",
                  "Q+W"
                ]
              },
              "metricSignature": {
                "enum": [
                  "-+++",
                  "+---"
                ]
              },
              "fourierNormalization": {
                "enum": [
                  "unitary",
                  "physics",
                  "none"
                ]
              },
              "unitSystem": {
                "enum": [
                  "SI",
                  "gaussian",
                  "natural"
                ]
              },
              "capacitorChargeSign": {
                "enum": [
                  "+",
                  "-"
                ]
              }
            }
          },
          "counterexamples": {
            "type": "array",
            "description": "src/relations/types.ts Counterexample; src/atlas/derive-evidence.ts reads it for contradicted.",
            "items": {
              "type": "object",
              "required": [
                "description",
                "witness"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "witness": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "regime": {
            "type": "object",
            "description": "The regime of the row (src/relations/types.ts Regime); src/composition/catalog-graph.ts puts it on the edge.",
            "required": [
              "family",
              "inequalities",
              "groupDefinitions"
            ],
            "additionalProperties": false,
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "inequalities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "group",
                    "op",
                    "bound"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "group": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "<",
                        "<=",
                        ">",
                        ">="
                      ]
                    },
                    "bound": {
                      "type": "number"
                    },
                    "alias": {
                      "type": "string"
                    }
                  }
                }
              },
              "groupDefinitions": {
                "type": "object"
              }
            }
          },
          "callerTable": {
            "const": true
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "Closed forms. Several relations may share one catalog id; catalogId null is a law with no catalog row.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "catalogId",
          "kind",
          "label",
          "expression",
          "target",
          "sources",
          "aliases",
          "holds",
          "domain",
          "citation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "catalogId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "bridge",
              "law"
            ]
          },
          "label": {
            "type": "string"
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "holds": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "established",
              "speculative",
              "highly-speculative"
            ],
            "description": "Stored only on a relation with no catalog row (catalogId null). A relation with a row takes its row's status when the catalog loads; src/bridges/catalog-load.ts refuses a stored copy beside a catalog id."
          },
          "citation": {
            "type": "string"
          },
          "coefficientUnset": {
            "type": "boolean"
          },
          "formulaFactors": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "reference": {
            "type": "object",
            "required": [
              "inputs",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "value": {
                "type": "number"
              }
            }
          },
          "notice": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "description": "Closed forms. Several relations may share one catalog id; catalogId null is a law with no catalog row. The relation contract, regime, conventions and counterexamples live on the row."
      }
    },
    "evaluators": {
      "type": "array",
      "description": "The input contract of each catalog evaluator: its named inputs and any extra outputs.",
      "items": {
        "type": "object",
        "required": [
          "catalogId",
          "name",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "catalogId": {
            "type": "integer",
            "minimum": 11
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "quantity",
                "symbol",
                "unit",
                "meaning"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A quantity id of data/quantities.json: the relation source the parameter binds, or the quantity an extra output reads."
                },
                "symbol": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "geometry": {
                  "enum": [
                    "radius",
                    "diameter",
                    "separation",
                    "impact-parameter",
                    "semi-major-axis"
                  ]
                },
                "temperature": {
                  "const": "absolute"
                },
                "sign": {
                  "enum": [
                    "positive",
                    "nonnegative",
                    "any"
                  ]
                },
                "angular": {
                  "const": true
                },
                "alternates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "meaning",
                      "toKey"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "meaning": {
                        "type": "string",
                        "minLength": 1
                      },
                      "toKey": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "unit",
                "meaning",
                "expression"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "expression": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "Extra numbers beside value. An output is computed when every parameter key its expression reads was given; a parameter only an output reads is optional."
          }
        }
      }
    },
    "spine": {
      "type": "object",
      "description": "Catalog id → the regime parameters of its evidence-spine confrontation, by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number"
        }
      }
    },
    "rejections": {
      "type": "array",
      "description": "The negative catalog: rows adjudicated not-a-bridge under the membership criterion. src/bridges/rejected.ts projects it; src/bridges/membership.ts overlays it.",
      "items": {
        "type": "object",
        "required": [
          "catalogId",
          "name",
          "reason",
          "citation"
        ],
        "additionalProperties": false,
        "properties": {
          "catalogId": {
            "type": "integer",
            "minimum": 11
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 40
          },
          "citation": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPT applied-case catalog",
  "description": "Declarative applied-case records. Loaded by src/cases/catalog.ts against this schema via src/core/data-file.ts.",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["key", "quantity", "symbol", "unit", "meaning"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "unit": { "type": "string" },
        "meaning": { "type": "string", "minLength": 1 },
        "geometry": { "enum": ["length", "area", "volume", "radius", "separation"] },
        "temperature": { "const": "absolute" },
        "sign": { "enum": ["positive", "nonnegative", "any"] },
        "angular": { "const": true },
        "optional": { "const": true },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "meaning", "toKey"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "meaning": { "type": "string", "minLength": 1 },
              "toKey": { "type": "number" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["key", "symbol", "unit", "meaning"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "unit": { "type": "string" },
        "meaning": { "type": "string", "minLength": 1 },
        "expr": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "relation": {
          "type": "object",
          "required": ["relation", "inputs"],
          "additionalProperties": false,
          "properties": {
            "relation": { "type": "string", "minLength": 1 },
            "inputs": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "premise", "quantity", "expr", "op", "bound", "threshold"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "premise": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "expr": { "type": "string", "minLength": 1 },
        "op": { "enum": ["<=", ">=", ">"] },
        "bound": { "type": "number" },
        "threshold": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "parameters",
        "governing",
        "observable",
        "outputs",
        "checks",
        "conditions",
        "notIncluded",
        "measurement",
        "links",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^case-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "governing": {
          "type": "object",
          "required": ["parent", "scalar", "distinction"],
          "additionalProperties": false,
          "properties": {
            "parent": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "scalar": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "distinction": { "type": "string", "minLength": 1 }
          }
        },
        "observable": { "type": "string", "minLength": 1 },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/output" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "notIncluded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "measurement": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "comparison": {
          "type": "object",
          "required": ["reference", "valueKey", "referenceKey", "deviationKey", "method"],
          "additionalProperties": false,
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "valueKey": { "type": "string", "minLength": 1 },
            "referenceKey": { "type": "string", "minLength": 1 },
            "deviationKey": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 }
          }
        },
        "examples": {
          "type": "object",
          "required": ["valid", "failures"],
          "additionalProperties": false,
          "properties": {
            "valid": {
              "type": "object",
              "required": ["args", "note", "fails"],
              "additionalProperties": false,
              "properties": {
                "args": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "note": { "type": "string", "minLength": 1 },
                "fails": { "type": "array", "items": { "type": "string" } }
              }
            },
            "failures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["args", "note", "fails"],
                "additionalProperties": false,
                "properties": {
                  "args": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  "note": { "type": "string", "minLength": 1 },
                  "fails": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                }
              }
            }
          }
        },
        "regimeAt": { "type": "string", "minLength": 1 }
      }
    }
  }
}

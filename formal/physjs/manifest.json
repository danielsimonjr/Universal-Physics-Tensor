        "theorem": "PhysJS.Mond.mu_inversion",
        "covers": "derivation-step: for z > 0, y = z ν(z) satisfies y² / √(1 + y²) = z, which inverts μ(x) = x / √(1 + x²)",
        "coverage": "covers its statement only",
        "leanProof": "complete",
        "axioms": ["propext", "Classical.choice", "Quot.sound"]
      }
    },

# Dependencies
node_modules/
# Lockfile is bun.lock (committed). Do not reintroduce package-lock.json —
# two lockfiles disagree; CI uses `bun install --frozen-lockfile`.

# Build outputs
dist/
*.tsbuildinfo
# Orphan tsc emits in tests/ — guard against re-emission if a src/ module
# briefly imports a tests/fixtures file then is changed back. (Happened
# once during the v0.7 PG metric module's iteration; left .d.ts/.js
# artifacts that aren't cleaned up by tsc on next run.)
tests/**/*.js
tests/**/*.d.ts
tests/**/*.js.map
tests/**/*.d.ts.map

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code per-session ephemeral state (worktree isolation for
# parallel agents; auto-cleaned after agent completion).
.claude/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output

# Environment
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.bak

# Generated extraction artifacts (LLM/build output, not source)
_bridge_extract.json
_bridge_extract_enriched.json

# Benchmark CI output (generated by npm run bench:ci)
bench/results.json

# Vendored utility tools (tools/) install dependencies per-tool — never
# commit them. The root `node_modules/` and `dist/` rules above already
# match these recursively; this entry is explicit for discoverability.
tools/**/node_modules
tools/**/dist

# Agent-local tracker-discipline config (infrastructure, not project content)
.tracker-watch.json

*.orig

# Lake build output for lean/ (CI-built, never committed)
.lake/

#!/bin/sh
# PRE-PUSH GATE — runs BEFORE the push, not after.
#
# WHY THIS EXISTS. Every rule I adopted after putting master red was a DETECTOR:
# "run `gh run list` in the same breath as the push", "read the message not the
# grep count". Those shortened detection from NINE commits red, to two, to one —
# a real curve — but not one of them PREVENTS the push. Mothership named that on
# the third ask: every fix was a detector, and all three incidents would have
# been stopped by a gate that ran first.
#
#   a105f885   master red for 9 commits (docs-fresh). A peer's sweep told me.
#   501b86c    red for 2 commits. Same job. My own recorded recurrence.
#   8a3359b    red for 1 commit: "the typecheck failed and I pushed it anyway."
#
# MEASURED COST, because "too slow" needed a number and not an impression. When
# this gate held typecheck and the docs check only, it measured ~6 s (typecheck
# 2 s, install + docs:deps 3 s, staleness 1 s), and six seconds would have
# prevented all three. The full suite was added below on 2026-09-21; its cost is
# stated there, with its date, and it is minutes, not seconds. The argument did
# not change: a red master costs more than the gate.
#
# Bypass with `git push --no-verify`. That is deliberate: a gate nobody can skip
# gets disabled wholesale, and a skip that must be typed is VISIBLE in a way that
# a quietly disabled hook is not.

set -e

# From a linked worktree git exports an absolute GIT_DIR, and the test suite's temp-dir
# `git init` / `git commit` inherited it and acted on this repository. Drop it first.
. "$(dirname "$0")/scrub-git-env.sh"

# The gates below read the working tree (tsc compiles tests/**, vitest runs every test file on
# disk, and tests read data/, bin/, docs/ and more), so they must see exactly the commit being
# pushed. An untracked stray test once failed the typecheck, and an unpushed edit could pass it.
# First: the commit being pushed must be HEAD. The tool reads git's "<local ref> <local sha>
# <remote ref> <remote sha>" lines from this hook's stdin and peels an annotated tag's sha to its
# commit (comparing the raw tag-object sha once refused every release tag).
echo "pre-push gate: the pushed commit is HEAD"
if ! bun tools/gate-inputs/pushed-head.ts; then
  exit 1
fi
# Second: the working tree must equal HEAD.
echo "pre-push gate: the working tree equals HEAD"
if ! bun tools/gate-inputs/gate-inputs.ts; then
  exit 1
fi
# Third: build, because tsconfig.tests.json reads types from the gitignored dist/. Without this the
# typecheck judges whatever dist/ the last build left. CI builds before it typechecks.
echo "pre-push gate: build"
if ! bun run build; then
  echo "PRE-PUSH GATE FAILED: build."
  exit 1
fi

# The build above IS the src typecheck (`tsc` exits non-zero on a type error, emit or not), so
# only the tests project is checked here. `bun run typecheck` would compile src a second time.
echo "pre-push gate: typecheck (tests project)"
if ! bun run typecheck:tests; then
  echo ""
  echo "PRE-PUSH GATE FAILED: typecheck."
  echo "Read the MESSAGE above, not an error count — on 2026-09-21 I piped this"
  echo "through 'grep -c', saw '1', and pushed anyway."
  exit 1
fi

# ---------------------------------------------------------------------------
# THE FULL TEST SUITE.
#
# ADDED 2026-09-21 after this gate passed a commit that CI then failed. The gate
# covered typecheck and docs but NOT tests, and my manual boundary ran only
# `tests/atlas/` and `tests/composition/` — while the guard that caught the
# defect lives in `tests/api/`. A scoped boundary is a gate with a hole shaped
# exactly like the directories you did not think of.
#
# THE COST IS MINUTES. When this step was added it measured 58 s warm for 4,144
# tests; the suite has grown since. The 9.0.0 run on the CI runner measured
# 654 s wall for 6,531 tests (2026-10-09). The first run after a reboot is slower
# still. Quote the current figure with its date, never the one from a smaller
# suite: the 58 s number was once carried as the steady-state cost and used to
# justify a scoped subset, and the directory the subset skipped is where a defect
# reached master (TOOLS.md, Test). The suite is run through vitest directly: the
# `test` script's `pretest` would compile src a third time, and the build above
# already did.
echo "pre-push gate: full test suite (minutes; CI measured 654 s at 9.0.0)"
if ! bunx vitest run; then
  echo ""
  echo "PRE-PUSH GATE FAILED: tests."
  echo "Read which SUITE failed — a scoped local run may not have covered it."
  exit 1
fi

echo "pre-push gate: architecture docs freshness"
# --frozen-lockfile FIRST. The nine-commit red was caused by regenerating with a
# js-yaml that differed from the lockfile's: the generator's own version is an
# input, and an idempotent run with the wrong input is stable at a wrong answer.
#
# Neither command may have its status swallowed: with `|| true` a crashed
# generator left the tree unchanged, the diff below was empty, and the gate
# printed OK while CI's docs-fresh job failed on the same commit. A failing
# generator is a failing gate, and its output is the diagnosis, so it is not
# sent to /dev/null either. (A tool that is NOT INSTALLED is a different
# outcome, handled by the skip branch further down.)
if ! bun install --frozen-lockfile >/dev/null; then
  echo ""
  echo "PRE-PUSH GATE FAILED: bun install --frozen-lockfile."
  exit 1
fi
if ! bun run docs:deps; then
  echo ""
  echo "PRE-PUSH GATE FAILED: docs:deps (the generator) did not finish."
  echo "Read its output above. An unchanged docs/architecture/ after a crash is NOT freshness."
  exit 1
fi

if ! git diff --quiet -- docs/architecture/; then
  echo ""
  echo "PRE-PUSH GATE FAILED: docs/architecture/ is stale."
  echo "The regeneration has already run — the files are updated in your tree."
  echo "Commit them and push again:"
  echo "    git add docs/architecture/ && git commit --amend --no-edit"
  echo ""
  git diff --stat -- docs/architecture/
  exit 1
fi

echo "pre-push gate: README and ROADMAP status spans"
if ! bun scripts/readme-status.ts --check; then
  echo ""
  echo "PRE-PUSH GATE FAILED: a README or ROADMAP status span is stale."
  echo "Run bun scripts/readme-status.ts (after docs:deps) and commit the files."
  exit 1
fi

echo "pre-push gate: PhysJS table freshness"
if ! bun scripts/generate-physjs-table.ts --check; then
  echo ""
  echo "PRE-PUSH GATE FAILED: src/atlas/physjs-entries.generated.ts is stale."
  echo "Run bun run physjs:table and commit the file."
  exit 1
fi

# ---------------------------------------------------------------------------
# code-docs and the architecture-docs claims, both through `repo-tools`.
#
# code-docs: every exported function, class, interface, type alias and method
# under src/ needs a doc comment. The tool does not check exported constants.
# `repo-tools docs check src` exits 0 on PASS and non-zero on a MUST issue or
# when it cannot measure the root, so its exit status is a verdict. The hook also
# requires the PASS line: a run that exits 0 and prints no verdict measured
# nothing, and must not read as a pass. The count of MUST issues is zero, so
# there is no backlog to ratchet against and no baseline file: any MUST issue
# fails the push. On a PASS the tool counts SHOULD issues; they are not gated.
#
# The command needs @danielsimonjr/repo-tools 2.2.2 or later. Before 2.2.0 there
# is no `docs` command. 2.2.0 and 2.2.1 report the implementation signature of an
# overloaded function as undocumented, and src/ has such functions. An older
# install exits non-zero, so the hook fails and prints the tool's own output; it
# never skips an installed tool.
#
# Architecture-docs CLAIMS: the `## Verification` tables in docs/architecture/
# checked against a fresh parse by `repo-tools check`. Its scope is those claim
# tables, and only those: it does not check prose, and `docs:deps` / the
# `docs-fresh` CI job check only the generated dependency artifacts. The two
# gates cover different files; neither is "the docs gate".
#
# repo-tools is the public npm package @danielsimonjr/repo-tools (Node 20+).
# Its location is a machine fact, not a repository fact: UPT_REPO_TOOLS names
# the executable, and `repo-tools` on PATH is only the default. Both gates are
# SKIPPED, each with a printed line, only when the executable is missing. CI
# runs the claims check in its own job; its code-docs job is the in-repo
# stand-in for changed paths, and CI does not run `repo-tools docs check src`.
REPO_TOOLS="${UPT_REPO_TOOLS:-repo-tools}"
if command -v "$REPO_TOOLS" >/dev/null 2>&1; then
  echo "pre-push gate: code-docs (repo-tools docs check src)"
  if ! cd_out=$("$REPO_TOOLS" docs check src 2>&1); then
    echo ""
    echo "PRE-PUSH GATE FAILED: code-docs found MUST issues, or the checker did not run."
    printf '%s\n' "$cd_out"
    echo "Document each exported symbol the list names. The command needs"
    echo "@danielsimonjr/repo-tools 2.2.2 or later."
    exit 1
  fi
  if ! printf '%s\n' "$cd_out" | grep -E "^PASS -- "; then
    echo ""
    echo "PRE-PUSH GATE FAILED: code-docs exited 0 but printed no PASS line."
    echo "The checker's output changed or it did not check; its output was:"
    printf '%s\n' "$cd_out" | tail -20
    exit 1
  fi

  echo "pre-push gate: architecture-docs claims (repo-tools check)"
  if ! rt_out=$("$REPO_TOOLS" check . --docs=docs/architecture 2>&1); then
    echo ""
    echo "PRE-PUSH GATE FAILED: architecture-docs claims do not match the source."
    printf '%s\n' "$rt_out" | tail -40
    echo "Re-measure with repo-tools map and correct the Verification tables and the"
    echo "text that restates them. Never edit a generated report to make this pass."
    exit 1
  fi
else
  echo "pre-push gate: code-docs SKIPPED (not found: $REPO_TOOLS; install @danielsimonjr/repo-tools or set UPT_REPO_TOOLS)"
  echo "pre-push gate: architecture-docs claims SKIPPED (not found: $REPO_TOOLS; install @danielsimonjr/repo-tools or set UPT_REPO_TOOLS)"
fi

echo "pre-push gate: OK"

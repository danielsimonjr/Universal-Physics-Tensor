#!/bin/sh
# PRE-PUSH GATE — runs BEFORE the push, not after.
#
# WHY THIS EXISTS. Every rule I adopted after putting master red was a DETECTOR:
# "run `gh run list` in the same breath as the push", "read the message not the
# grep count". Those shortened detection from NINE commits red, to two, to one —
# a real curve — but not one of them PREVENTS the push. Mothership named that on
# the third ask: every fix was a detector, and all three incidents would have
# been stopped by a gate that ran first.
#
#   a105f885   master red for 9 commits (docs-fresh). A peer's sweep told me.
#   501b86c    red for 2 commits. Same job. My own recorded recurrence.
#   8a3359b    red for 1 commit: "the typecheck failed and I pushed it anyway."
#
# MEASURED COST, because "too slow" needed a number and not an impression:
#   typecheck            2s
#   install + docs:deps  3s
#   staleness check      1s
#   TOTAL                ~6s
# Six seconds would have prevented all three. There is no speed argument.
#
# Bypass with `git push --no-verify`. That is deliberate: a gate nobody can skip
# gets disabled wholesale, and a skip that must be typed is VISIBLE in a way that
# a quietly disabled hook is not.

set -e

# From a linked worktree git exports an absolute GIT_DIR, and the test suite's temp-dir
# `git init` / `git commit` inherited it and acted on this repository. Drop it first.
. "$(dirname "$0")/scrub-git-env.sh"

# The gates below read the working tree (tsc compiles tests/**, vitest runs every test file on
# disk, and tests read data/, bin/, docs/ and more), so they must see exactly the commit being
# pushed. An untracked stray test once failed the typecheck, and an unpushed edit could pass it.
# First: the commit being pushed must be HEAD. The tool reads git's "<local ref> <local sha>
# <remote ref> <remote sha>" lines from this hook's stdin and peels an annotated tag's sha to its
# commit (comparing the raw tag-object sha once refused every release tag).
echo "pre-push gate: the pushed commit is HEAD"
if ! bun tools/gate-inputs/pushed-head.ts; then
  exit 1
fi
# Second: the working tree must equal HEAD.
echo "pre-push gate: the working tree equals HEAD"
if ! bun tools/gate-inputs/gate-inputs.ts; then
  exit 1
fi
# Third: build, because tsconfig.tests.json reads types from the gitignored dist/. Without this the
# typecheck judges whatever dist/ the last build left. CI builds before it typechecks.
echo "pre-push gate: build"
if ! bun run build; then
  echo "PRE-PUSH GATE FAILED: build."
  exit 1
fi

echo "pre-push gate: typecheck"
if ! bun run typecheck; then
  echo ""
  echo "PRE-PUSH GATE FAILED: typecheck."
  echo "Read the MESSAGE above, not an error count — on 2026-09-21 I piped this"
  echo "through 'grep -c', saw '1', and pushed anyway."
  exit 1
fi

# ---------------------------------------------------------------------------
# THE FULL TEST SUITE.
#
# ADDED 2026-09-21 after this gate passed a commit that CI then failed. The gate
# covered typecheck and docs but NOT tests, and my manual boundary ran only
# `tests/atlas/` and `tests/composition/` — while the guard that caught the
# defect lives in `tests/api/`. A scoped boundary is a gate with a hole shaped
# exactly like the directories you did not think of.
#
# I HAD ASSUMED THIS WAS TOO SLOW AND THE ASSUMPTION WAS WRONG. CLAUDE.md warns
# of "3-5 min cold-start on Windows", and I had carried that as the steady-state
# cost. MEASURED WARM: 58s for 4,144 tests. That is affordable to prevent a red
# master; the cold-start figure is real but applies to the first run after a
# reboot, not to every push.
echo "pre-push gate: full test suite (~60s warm)"
if ! bun run test; then
  echo ""
  echo "PRE-PUSH GATE FAILED: tests."
  echo "Read which SUITE failed — a scoped local run may not have covered it."
  exit 1
fi

echo "pre-push gate: architecture docs freshness"
# --frozen-lockfile FIRST. The nine-commit red was caused by regenerating with a
# js-yaml that differed from the lockfile's: the generator's own version is an
# input, and an idempotent run with the wrong input is stable at a wrong answer.
bun install --frozen-lockfile >/dev/null 2>&1 || true
bun run docs:deps >/dev/null 2>&1 || true

if ! git diff --quiet -- docs/architecture/; then
  echo ""
  echo "PRE-PUSH GATE FAILED: docs/architecture/ is stale."
  echo "The regeneration has already run — the files are updated in your tree."
  echo "Commit them and push again:"
  echo "    git add docs/architecture/ && git commit --amend --no-edit"
  echo ""
  git diff --stat -- docs/architecture/
  exit 1
fi

# ---------------------------------------------------------------------------
# code-docs, as a RATCHET rather than a wall.
#
# MEASURED 2026-09-21 before wiring it, because Mothership suggested "typecheck
# plus the two doc gates" and I said I would measure rather than ship two thirds
# of her suggestion and call it done:
#   runtime            2s  (speed was never the objection)
#   MUST issues        171 across 305 files
#
# So BLOCKING on it is not a gate, it is a wall: every push refused until 171
# pre-existing findings are cleared, or `--no-verify` typed every single time.
# A gate bypassed on every push is WORSE than no gate, because it teaches the
# bypass and the next real failure rides through the same habit.
#
# The ratchet blocks NEW debt without demanding the backlog: fail only if the
# count rises above the committed baseline. The baseline is a file in the repo,
# so lowering it is a visible, reviewed act — and a number sitting in version
# control is pressure the backlog would not otherwise carry.
CODE_DOCS="$HOME/Github/skills/code-docs/scripts/code_docs.py"
BASELINE_FILE="$(dirname "$0")/code-docs-baseline.txt"

if [ -f "$CODE_DOCS" ] && [ -f "$BASELINE_FILE" ]; then
  echo "pre-push gate: code-docs ratchet"
  baseline=$(cat "$BASELINE_FILE")
  # `check` exits 1 whenever MUST issues exist, and this hook runs under `set -e`,
  # so the exit status cannot be the verdict. The PASS/FAIL line is, below.
  cd_out=$(python "$CODE_DOCS" check src 2>&1) || true
  # Read the count ONLY from a line the tool writes on purpose. This used to be
  # `grep ... || echo 0`, so a crash, or a change in the tool's output, read as
  # "0 MUST issues" and the ratchet passed - and even reported an improvement.
  if current=$(printf '%s
' "$cd_out" | grep -oE "^FAIL -- [0-9]+ MUST" | grep -oE "[0-9]+"); then
    :
  elif printf '%s
' "$cd_out" | grep -qE "^PASS -- "; then
    current=0
  else
    echo ""
    echo "PRE-PUSH GATE FAILED: code-docs gave neither a PASS nor a FAIL line."
    echo "The tool crashed or its output changed; its output was:"
    printf '%s
' "$cd_out" | tail -20
    exit 1
  fi

  if [ "$current" -gt "$baseline" ]; then
    echo ""
    echo "PRE-PUSH GATE FAILED: code-docs went UP ($baseline -> $current)."
    echo "You added an undocumented exported symbol. Document it, or if this is"
    echo "deliberate, raise the baseline in .githooks/code-docs-baseline.txt so"
    echo "the increase is a reviewed line in the diff rather than a silent drift."
    exit 1
  fi

  if [ "$current" -lt "$baseline" ]; then
    echo "  code-docs IMPROVED: $baseline -> $current. Lower the baseline:"
    echo "    echo $current > .githooks/code-docs-baseline.txt"
  fi
else
  # Skip rather than block: code_docs.py lives outside this repo, and a gate that
  # fails because a SKILL is missing would train people to bypass it for reasons
  # that have nothing to do with this codebase.
  echo "pre-push gate: code-docs SKIPPED (tool or baseline not found)"
fi

# Architecture-docs CLAIMS: the `## Verification` tables in docs/architecture/
# checked against a fresh parse by repo_map.py. Its scope is those claim tables,
# and only those: it does not check prose, and `docs:deps` / the `docs-fresh` CI
# job check only the generated dependency artifacts. The two gates cover
# different files; neither is "the docs gate".
#
# This runs HERE and not in CI because repo_map.py lives in a private repository
# that CI cannot read without a credential. That is a recorded decision, not an
# oversight.
REPO_MAP="$HOME/Github/skills/architecture-docs/scripts/repo_map.py"
if [ -f "$REPO_MAP" ]; then
  echo "pre-push gate: architecture-docs claims (repo_map check)"
  if ! rm_out=$(python "$REPO_MAP" check . --docs docs/architecture 2>&1); then
    echo ""
    echo "PRE-PUSH GATE FAILED: architecture-docs claims do not match the source."
    printf '%s
' "$rm_out" | tail -40
    echo "Re-measure with repo_map.py map and correct the Verification tables and the"
    echo "text that restates them. Never edit a generated report to make this pass."
    exit 1
  fi
else
  echo "pre-push gate: architecture-docs claims SKIPPED (repo_map.py not found)"
fi

echo "pre-push gate: OK"
